+/* TOKEN_HELPERS_BEGIN */
+static inline int ff_v4l2_pts_prepare(const V4L2m2mContext *s, int64_t *token)
+{
+    if (s->pts_token_counter >= V4L2_PTS_TOKEN_MAX)
+        return AVERROR(ERANGE);
+    *token = s->pts_token_counter + 1;
+    return 0;
+}
+
+static inline void ff_v4l2_pts_commit(V4L2m2mContext *s, int64_t token, int64_t pts)
+{
+    V4L2PtsEntry *entry = &s->pts_map[token % V4L2_PTS_MAP_SIZE];
+    entry->pts = pts;
+    entry->token = token;
+    s->pts_token_counter = token;
+}
+
+static inline int ff_v4l2_pts_restore(const V4L2m2mContext *s,
+                                    int64_t sec, int64_t usec, int64_t *pts)
+{
+    const V4L2PtsEntry *entry;
+    int64_t token;
+
+    if (sec < 0 || usec < 0 || usec >= 1000000 ||
+        sec > V4L2_PTS_TOKEN_MAX / 1000000)
+        return AVERROR_INVALIDDATA;
+    token = sec * 1000000 + usec;
+    if (token <= 0 || token > V4L2_PTS_TOKEN_MAX ||
+        token > s->pts_token_counter)
+        return AVERROR_INVALIDDATA;
+    entry = &s->pts_map[token % V4L2_PTS_MAP_SIZE];
+    if (entry->token != token)
+        return AVERROR_INVALIDDATA;
+    *pts = entry->pts;
+    return 0;
+}
+/* TOKEN_HELPERS_END */
 
