+    /* Single decoder thread owns this map; capture buffer free callbacks do not.
+     * Preserve across capture reconfiguration; lifetime is the decoder context.
+     */
+    int64_t pts_token_counter;
+    V4L2PtsEntry pts_map[V4L2_PTS_MAP_SIZE];
