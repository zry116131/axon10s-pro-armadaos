+/* Decoder-only timestamps: no raw signed PTS crosses the V4L2 ABI. */
+#define V4L2_PTS_MAP_SIZE 4096
+#define V4L2_PTS_TOKEN_MAX (INT64_MAX / 1000)
+
+typedef struct V4L2PtsEntry {
+    int64_t token;
+    int64_t pts;
+} V4L2PtsEntry;
 
