+static int v4l2_finish_drc(AVCodecContext *avctx)
+{
+    V4L2m2mContext *s = ((V4L2m2mPriv *)avctx->priv_data)->context;
+    struct v4l2_format fmt = s->capture.format;
+    struct v4l2_rect visible;
+    unsigned int allocated_width, allocated_height;
+    int ret, have_visible;
+
+    if (ioctl(s->fd, VIDIOC_G_FMT, &fmt) < 0)
+        return AVERROR(errno);
+    if (V4L2_TYPE_IS_MULTIPLANAR(s->capture.type)) {
+        s->capture.width = fmt.fmt.pix_mp.width;
+        s->capture.height = fmt.fmt.pix_mp.height;
+    } else {
+        s->capture.width = fmt.fmt.pix.width;
+        s->capture.height = fmt.fmt.pix.height;
+    }
+    allocated_width = s->capture.width;
+    allocated_height = s->capture.height;
+    /* Venus S_FMT resets inst->crop: save the visible rectangle first. */
+    have_visible = v4l2_save_visible(s, allocated_width, allocated_height, &visible);
+    if (have_visible < 0)
+        return have_visible;
+    ret = ff_set_dimensions(avctx, allocated_width, allocated_height);
+    if (ret < 0)
+        return ret;
+    ret = ff_v4l2_m2m_codec_reinit(s);
+    if (ret < 0)
+        return ret;
+    s->capture.done = 0;
+    ret = v4l2_try_start(avctx);
+    if (ret < 0)
+        return ret;
+    if (have_visible) {
+        /* Only visible frame dimensions change; format/strides stay allocated. */
+        unsigned int width = V4L2_TYPE_IS_MULTIPLANAR(s->capture.type) ?
+                             s->capture.format.fmt.pix_mp.width :
+                             s->capture.format.fmt.pix.width;
+        unsigned int height = V4L2_TYPE_IS_MULTIPLANAR(s->capture.type) ?
+                              s->capture.format.fmt.pix_mp.height :
+                              s->capture.format.fmt.pix.height;
+        if (visible.width > width || visible.height > height)
+            return AVERROR_INVALIDDATA;
+        s->capture.width = avctx->width = visible.width;
+        s->capture.height = avctx->height = visible.height;
+    }
+    s->drc_pending = 0;
+    s->drc_ready = 0;
+    return 0;
+}
