+static int v4l2_save_visible(V4L2m2mContext *s, unsigned int width,
+                             unsigned int height, struct v4l2_rect *visible)
+{
+    struct v4l2_selection selection = {
+        .type = V4L2_BUF_TYPE_VIDEO_CAPTURE,
+        .target = V4L2_SEL_TGT_COMPOSE,
+    };
+    if (ioctl(s->fd, VIDIOC_G_SELECTION, &selection) < 0) {
+        if (errno != EINVAL && errno != ENOTTY)
+            return AVERROR(errno);
+        selection.target = V4L2_SEL_TGT_COMPOSE_DEFAULT;
+        if (ioctl(s->fd, VIDIOC_G_SELECTION, &selection) < 0)
+            return errno == EINVAL || errno == ENOTTY ? 0 : AVERROR(errno);
+    }
+    if (selection.r.left || selection.r.top)
+        return AVERROR(ENOSYS);
+    if (!selection.r.width || !selection.r.height ||
+        selection.r.width > width || selection.r.height > height)
+        return AVERROR_INVALIDDATA;
+    *visible = selection.r;
+    return 1;
+}
