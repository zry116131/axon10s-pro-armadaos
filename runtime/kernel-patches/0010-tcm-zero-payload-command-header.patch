 static int tcm_command(struct tcm_data *tcm, u8 cmd, int arg, void *buf, size_t length)
 {
-    u8 packet[4] = {cmd, 1, 0, arg};
-    int ret, n = arg < 0 ? 1 : 4;
+    u8 packet[4] = {cmd, arg < 0 ? 0 : 1, 0, arg};
