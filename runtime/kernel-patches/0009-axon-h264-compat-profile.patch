+/* Explicit compatibility profile; firmware advertisement is not a safety gate. */
+static bool axon_h264_compat;
+module_param(axon_h264_compat, bool, 0400);
+MODULE_PARM_DESC(axon_h264_compat, "Limit Axon SM8250 HFI6 decoder to H264");
+
+static bool vdec_axon_h264_compat(struct venus_inst *inst)
+{
+	return axon_h264_compat &&
+		of_machine_is_compatible("zte,axon10s-pro") &&
+		of_device_is_compatible(inst->core->dev->of_node,
+					"qcom,sm8250-venus") &&
+		inst->session_type == VIDC_SESSION_TYPE_DEC &&
+		inst->core->res->hfi_version == HFI_VERSION_6XX;
+}
