+/* Unique vote tokens are never reused within this built-in driver lifetime. */
+static atomic_t vote_last_token = ATOMIC_INIT(0xffff);
+
+static int q6afe_alloc_vote_token(u32 *token)
+{
+	int last = atomic_read(&vote_last_token);
+
+	for (;;) {
+		int previous;
+
+		if (last == INT_MAX)
+			return -EOVERFLOW;
+		previous = atomic_cmpxchg(&vote_last_token, last, last + 1);
+		if (previous == last) {
+			*token = last + 1;
+			return 0;
+		}
+		last = previous;
+	}
+}
+
+/* Caller holds afe->lock across this transaction; callbacks only take
+ * vote_lock, never afe->lock. No caller output pointer is retained.
+ */
+static bool q6afe_vote_done(struct q6afe *afe)
+{
+	unsigned long flags;
+	bool done;
+
+	spin_lock_irqsave(&afe->vote_lock, flags);
+	done = afe->vote_done;
+	spin_unlock_irqrestore(&afe->vote_lock, flags);
+	return done;
+}
+
+static void q6afe_vote_reply(struct q6afe *afe, u32 token, u32 handle)
+{
+	unsigned long flags;
+	bool accepted = false;
+
+	spin_lock_irqsave(&afe->vote_lock, flags);
+	if (afe->vote_pending && !afe->vote_poisoned &&
+	    token == afe->vote_token) {
+		afe->vote_result = handle;
+		afe->vote_pending = false;
+		afe->vote_done = true;
+		accepted = true;
+	}
+	spin_unlock_irqrestore(&afe->vote_lock, flags);
+	if (accepted)
+		wake_up(&afe->vote_wait);
+}
+
+static int q6afe_send_vote_locked(struct q6afe *afe, struct apr_pkt *pkt,
+				 u32 *client_handle)
+{
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&afe->vote_lock, flags);
+	if (afe->vote_poisoned) {
+		spin_unlock_irqrestore(&afe->vote_lock, flags);
+		return -EIO;
+	}
+	{
+		u32 token;
+
+		ret = q6afe_alloc_vote_token(&token);
+		if (ret) {
+			spin_unlock_irqrestore(&afe->vote_lock, flags);
+			return ret;
+		}
+		pkt->hdr.token = token;
+	}
+	afe->vote_token = pkt->hdr.token;
+	afe->vote_done = false;
+	afe->vote_pending = true;
+	spin_unlock_irqrestore(&afe->vote_lock, flags);
+
+	ret = apr_send_pkt(afe->apr, pkt);
+	if (ret < 0) {
+		/* A failed send is conservatively treated as uncertain delivery. */
+		ret = -EINVAL;
+		goto poison;
+	}
+	ret = wait_event_timeout(afe->vote_wait, q6afe_vote_done(afe),
+				 msecs_to_jiffies(TIMEOUT_MS));
+	if (!ret) {
+		ret = -ETIMEDOUT;
+		goto poison;
+	}
+
+	spin_lock_irqsave(&afe->vote_lock, flags);
+	*client_handle = afe->vote_result;
+	afe->vote_done = false;
+	spin_unlock_irqrestore(&afe->vote_lock, flags);
+	return 0;
+
+poison:
+	spin_lock_irqsave(&afe->vote_lock, flags);
+	afe->vote_pending = false;
+	afe->vote_done = false;
+	afe->vote_poisoned = true;
+	spin_unlock_irqrestore(&afe->vote_lock, flags);
+	return ret;
+}
