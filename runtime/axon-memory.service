[Unit]
Description=Axon verified ZRAM and disk swap fallback
After=local-fs.target
Before=display-manager.service
ConditionPathExists=/var/lib/axon-swap/swapfile

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/axon-memory-setup.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target axon-test.target
