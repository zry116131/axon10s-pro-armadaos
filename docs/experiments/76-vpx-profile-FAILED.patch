 	pm_runtime_mark_last_busy(inst->core->dev_dec);
 }
 
+/* Experimental stock-firmware compatibility: downstream initialization defaults. */
+static int vdec_axon_set_vpx_profile(struct venus_inst *inst)
+{
+	struct hfi_profile_level profile;
+
+	if (!of_machine_is_compatible("zte,axon10s-pro") ||
+	    !of_device_is_compatible(inst->core->dev->of_node,
+				     "qcom,sm8250-venus") ||
+	    inst->session_type != VIDC_SESSION_TYPE_DEC ||
+	    inst->core->res->hfi_version != HFI_VERSION_6XX ||
+	    inst->core->venus_ver.major != 1 ||
+	    inst->core->venus_ver.minor != 0 ||
+	    inst->core->venus_ver.rev != 90 || !inst->fmt_out)
+		return 0;
+
+	if (inst->fmt_out->pixfmt == V4L2_PIX_FMT_VP8) {
+		profile.profile = HFI_VPX_PROFILE_MAIN;
+		profile.level = HFI_VPX_LEVEL_VERSION_3;
+	} else if (inst->fmt_out->pixfmt == V4L2_PIX_FMT_VP9) {
+		profile.profile = HFI_VP9_PROFILE_P0;
+		profile.level = HFI_VP9_LEVEL_61;
+	} else {
+		return 0;
+	}
+
+	return hfi_session_set_property(inst,
+		HFI_PROPERTY_PARAM_PROFILE_LEVEL_CURRENT, &profile);
+}
