+/* Experimental downstream secondary-output property order for stock VPx. */
+static int vdec_set_dpb_stream_properties(struct venus_inst *inst)
+{
+	struct hfi_multi_stream multi;
+	int ret;
+	bool axon_vpx = of_machine_is_compatible("zte,axon10s-pro") &&
+		of_device_is_compatible(inst->core->dev->of_node,
+					"qcom,sm8250-venus") &&
+		inst->session_type == VIDC_SESSION_TYPE_DEC &&
+		inst->core->res->hfi_version == HFI_VERSION_6XX &&
+		inst->core->venus_ver.major == 1 &&
+		inst->core->venus_ver.minor == 0 &&
+		inst->core->venus_ver.rev == 90 && inst->fmt_out &&
+		(inst->fmt_out->pixfmt == V4L2_PIX_FMT_VP8 ||
+		 inst->fmt_out->pixfmt == V4L2_PIX_FMT_VP9) &&
+		inst->opb_buftype == HFI_BUFFER_OUTPUT2 &&
+		inst->dpb_buftype == HFI_BUFFER_OUTPUT;
+
+	if (!axon_vpx) {
+		ret = venus_helper_set_multistream(inst, false, true);
+		if (ret)
+			return ret;
+		return venus_helper_set_raw_format(inst, inst->dpb_fmt,
+						 inst->dpb_buftype);
+	}
+
+	ret = venus_helper_set_raw_format(inst, inst->dpb_fmt,
+					  inst->dpb_buftype);
+	if (ret)
+		return ret;
+	multi.buffer_type = HFI_BUFFER_OUTPUT2;
+	multi.enable = true;
+	ret = hfi_session_set_property(inst, HFI_PROPERTY_PARAM_VDEC_MULTI_STREAM,
+				       &multi);
+	if (ret)
+		return ret;
+	multi.buffer_type = HFI_BUFFER_OUTPUT;
+	multi.enable = false;
+	return hfi_session_set_property(inst, HFI_PROPERTY_PARAM_VDEC_MULTI_STREAM,
+					&multi);
+}
