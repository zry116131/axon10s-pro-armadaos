+#include <linux/atomic.h>
+#include <linux/of.h>
 #include <linux/delay.h>
 #include <linux/device.h>
 #include <linux/dma-mapping.h>
@@ -987,17 +989,63 @@
 
 static void venus_flush_debug_queue(struct venus_hfi_device *hdev)
 {
-	struct device *dev = hdev->core->dev;
+	static atomic_t axon_fw_budget = ATOMIC_INIT(32);
+	struct venus_core *core = hdev->core;
+	struct device *dev = core->dev;
 	void *packet = hdev->dbg_buf;
-
-	while (!venus_iface_dbgq_read(hdev, packet)) {
-		struct hfi_msg_sys_coverage_pkt *pkt = packet;
-
-		if (pkt->hdr.pkt_type != HFI_MSG_SYS_COV) {
-			struct hfi_msg_sys_debug_pkt *pkt = packet;
-
-			dev_dbg(dev, VDBGFW "%s", pkt->msg_data);
+	bool axon = of_machine_is_compatible("zte,axon10s-pro") &&
+		of_device_is_compatible(dev->of_node, "qcom,sm8250-venus") &&
+		core->res->hfi_version == HFI_VERSION_6XX &&
+		core->venus_ver.major == 1 && core->venus_ver.minor == 0 &&
+		core->venus_ver.rev == 90;
+
+	if (!axon) {
+		while (!venus_iface_dbgq_read(hdev, packet)) {
+			struct hfi_msg_sys_coverage_pkt *pkt = packet;
+
+			if (pkt->hdr.pkt_type != HFI_MSG_SYS_COV) {
+				struct hfi_msg_sys_debug_pkt *pkt = packet;
+
+				dev_dbg(dev, VDBGFW "%s", pkt->msg_data);
+			}
 		}
+		return;
+	}
+
+	for (;;) {
+		struct hfi_msg_sys_debug_pkt *pkt = packet;
+		const size_t offset = offsetof(struct hfi_msg_sys_debug_pkt, msg_data);
+		char text[257];
+		size_t length = 0, i;
+		bool emit = false;
+		int ret;
+
+		/* dbg_buf is shared: validate and copy while holding the read lock. */
+		mutex_lock(&hdev->lock);
+		ret = venus_iface_dbgq_read_nolock(hdev, packet);
+		if (!ret && pkt->hdr.size >= offset &&
+		    pkt->hdr.size <= sizeof(hdev->dbg_buf) &&
+		    !(pkt->hdr.size & 3) &&
+		    pkt->hdr.pkt_type == HFI_MSG_SYS_DEBUG &&
+		    pkt->msg_size <= pkt->hdr.size - offset) {
+			length = min_t(size_t, pkt->msg_size, 256);
+			length = strnlen((const char *)pkt->msg_data, length);
+			if (length && atomic_add_unless(&axon_fw_budget, -1, 0)) {
+				for (i = 0; i < length; i++) {
+					unsigned char c = pkt->msg_data[i];
+
+					/* One physical log line per reserved message. */
+					text[i] = c < 32 || c == 127 ? ' ' : c;
+				}
+				text[length] = '\0';
+				emit = true;
+			}
+		}
+		mutex_unlock(&hdev->lock);
+		if (ret)
+			break;
+		if (emit)
+			dev_info(dev, "AXON_VPX_FW %s\n", text);
 	}
 }
 
