+/* AXON diagnostic metadata only; no returned register data is retained. */
+#define AXON_SWR_TRACE_DEPTH 16
+
+enum axon_swr_trace_phase {
+	AXON_SWR_SUBMIT,
+	AXON_SWR_RESULT,
+	AXON_SWR_RETRY,
+	AXON_SWR_TIMEOUT,
+};
+
+struct axon_swr_trace_event {
+	u64 sequence;
+	u64 command;
