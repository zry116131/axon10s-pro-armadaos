+/* All timestamps describe software observation, not a proven IRQ cause. */
+static u64 axon_swr_trace_record(struct qcom_swrm_ctrl *ctrl, u64 command,
+			       u32 packed, enum axon_swr_trace_phase phase,
+			       u8 attempt, u8 returned_id, int read_ret)
+{
+	struct axon_swr_trace *trace = &ctrl->axon_trace;
+	struct axon_swr_trace_event *event;
+	unsigned long flags;
+
+	if (!trace->enabled)
+		return 0;
+
+	spin_lock_irqsave(&trace->lock, flags);
+	if (trace->frozen) {
+		spin_unlock_irqrestore(&trace->lock, flags);
+		return 0;
+	}
+	if (phase == AXON_SWR_SUBMIT)
+		command = ++trace->command;
+	if (!command) {
+		spin_unlock_irqrestore(&trace->lock, flags);
+		return 0;
+	}
+	event = &trace->events[trace->head];
+	event->sequence = ++trace->sequence;
+	event->command = command;
+	event->time_ns = ktime_get_ns();
+	event->packed = packed;
+	event->read_ret = read_ret;
+	event->phase = phase;
+	event->attempt = attempt;
+	event->returned_id = returned_id;
+	trace->head = (trace->head + 1) % AXON_SWR_TRACE_DEPTH;
+	if (trace->count < AXON_SWR_TRACE_DEPTH)
+		trace->count++;
+	spin_unlock_irqrestore(&trace->lock, flags);
+
+	return command;
+}
+
+static void axon_swr_trace_irq(struct qcom_swrm_ctrl *ctrl,
+			       u32 intr_sts, u32 intr_sts_masked)
+{
+	struct axon_swr_trace *trace = &ctrl->axon_trace;
+	struct axon_swr_trace_event events[AXON_SWR_TRACE_DEPTH];
+	unsigned long flags;
+	u64 sequence, time_ns;
+	u32 count, first, i;
+
+	if (!trace->enabled ||
+	    !(intr_sts_masked & SWRM_INTERRUPT_STATUS_READ_EN_RD_VALID_MISMATCH))
+		return;
+
+	spin_lock_irqsave(&trace->lock, flags);
+	if (trace->frozen) {
+		spin_unlock_irqrestore(&trace->lock, flags);
+		return;
+	}
+	trace->frozen = true;
+	count = trace->count;
+	sequence = trace->sequence;
+	time_ns = ktime_get_ns();
+	first = (trace->head + AXON_SWR_TRACE_DEPTH - count) % AXON_SWR_TRACE_DEPTH;
+	for (i = 0; i < count; i++)
+		events[i] = trace->events[(first + i) % AXON_SWR_TRACE_DEPTH];
+	spin_unlock_irqrestore(&trace->lock, flags);
+
+	dev_info(ctrl->dev, "AXON_SWR_TRACE snapshot_ns=%llu irq=%#x masked=%#x entries=%u total=%llu correlation=unproven frozen=1\n",
+		 (unsigned long long)time_ns, intr_sts, intr_sts_masked,
+		 count, (unsigned long long)sequence);
+	for (i = 0; i < count; i++) {
+		const struct axon_swr_trace_event *event = &events[i];
+
+		dev_info(ctrl->dev, "AXON_SWR_TRACE seq=%llu cmd=%llu ns=%llu phase=%u attempt=%u dev=%u reg=%#x len=%u expected_id=%u returned_id=%u returned_valid=%u read_ret=%d\n",
+			 (unsigned long long)event->sequence,
+			 (unsigned long long)event->command,
+			 (unsigned long long)event->time_ns,
+			 event->phase, event->attempt, (event->packed >> 20) & 0xf,
+			 event->packed & 0xffff, event->packed >> 24,
+			 (event->packed >> 16) & 0xf, event->returned_id,
+			 event->phase == AXON_SWR_RESULT && event->read_ret == SDW_CMD_OK,
+			 event->read_ret);
+	}
+}
